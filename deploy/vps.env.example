# Copy to deploy/vps.env (never committed: it holds the session key), then fill in.
#   cp deploy/vps.env.example deploy/vps.env

# Public address — the QR passports point at it. No trailing slash.
APP_URL=https://biovolailles.brandhubos.cloud

# 64 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   (or: openssl rand -hex 32)
SESSION_SECRET=

# The database file, on the container's persistent volume (/data).
DATABASE_URL=file:/data/biovolailles.db

# --- Demonstration / training instance (today's delivery) ---------------------------------
# Fictitious data, demo accounts, role switcher and in-app reset. Set both to false for the
# real installation (empty database, see DEPLOY_VPS.md, "Installation réelle").
DEMO_MODE=true
DEMO_SNAPSHOT_ON_FIRST_START=true

# --- Real installation: keys (64 random characters each, openssl rand -hex 32) -------------
# Encrypts two-step login secrets; without it, changing SESSION_SECRET breaks every enrolment.
# MFA_ENCRYPTION_KEY=
# Signs the ledger anchors (the hash-chained journal).
# LEDGER_ANCHOR_KEY=

# --- Real installation: company details shown on the public legal pages ----------------------
# LEGAL_ADDRESS=
# LEGAL_RC=
# LEGAL_ICE=
# LEGAL_CAPITAL=
# LEGAL_DIRECTOR=
# LEGAL_CONTACT=
# LEGAL_HOST=
# LEGAL_PRIVACY_EMAIL=
# LEGAL_CNDP_REF=
# LEGAL_PROCESSORS=
# LEGAL_LEAD_RETENTION=

# --- Optional -------------------------------------------------------------------------------
# Server errors e-mailed (at most one per kind every 30 min), comma-separated:
# ERRORS_NOTIFY_TO=
# Backups kept on this server, in days (the scheduler service; copy them elsewhere too):
# BACKUP_KEEP_DAYS=14
# Alert and lead e-mails through Resend (all three needed to send):
# RESEND_API_KEY=
# ALERTS_NOTIFY_FROM=BIOVOLAILLES <alertes@brandhubos.cloud>
# LEADS_NOTIFY_FROM=BIOVOLAILLES <contact@brandhubos.cloud>
# LEADS_NOTIFY_TO=
