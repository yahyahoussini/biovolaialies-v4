# REAL installation (client data). Copy to deploy/vps.env in a folder of its own, then fill in.
#   cp deploy/vps.env.production.example deploy/vps.env
# Generate each key with: openssl rand -hex 32

APP_URL=https://biovolailles.brandhubos.cloud
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
LEDGER_ANCHOR_KEY=
DATABASE_URL=file:/data/biovolailles.db

# No demonstration data, no role switcher, no in-app reset; two-step login demanded of
# Administrateur, Responsable qualité and Direction.
DEMO_MODE=false
DEMO_SNAPSHOT_ON_FIRST_START=false

# Company details on the public legal pages (shown as "À compléter" until set).
LEGAL_ADDRESS=
LEGAL_RC=
LEGAL_ICE=
LEGAL_CAPITAL=
LEGAL_DIRECTOR=
LEGAL_CONTACT=
LEGAL_HOST=
LEGAL_PRIVACY_EMAIL=
LEGAL_CNDP_REF=
LEGAL_PROCESSORS=
LEGAL_LEAD_RETENTION=

# E-mail through Resend (alerts, leads, server errors). Leave empty until the account exists.
RESEND_API_KEY=
ALERTS_NOTIFY_FROM=
LEADS_NOTIFY_FROM=
LEADS_NOTIFY_TO=
ERRORS_NOTIFY_TO=

# Backups kept on this server (days). Copy them off the server as well (EXPLOITATION.md §5.2).
BACKUP_KEEP_DAYS=14
