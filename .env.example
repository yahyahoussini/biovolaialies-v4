# ---------------------------------------------------------------------------
# Local development: copy this file to .env.local and fill it in.
# Deploying: set the same variables as Vercel Project Environment Variables.
# See README.md → "Deploying to Vercel".
# ---------------------------------------------------------------------------

# Database.
#
# Locally: a libSQL/SQLite file, created by `npm run db:migrate`.
#
# On Vercel you have two options:
#   - Leave DATABASE_URL UNSET (don't create it at all): the deployment runs from the seeded demo
#     snapshot shipped in the repo (data/demo/snapshot.db.gz). Zero setup, every visitor can log in.
#     Writes last only while an instance is warm — the demo resets itself. Ideal for showing a client.
#   - Set it to a remote libSQL URL (Turso) for a real, persistent database.
# A `file:` URL on Vercel is rejected at build time: the filesystem there is ephemeral and read-only.
#
#   Local : file:./data/db/biovolailles.db
#   Hosted: libsql://<your-database>-<your-org>.turso.io
DATABASE_URL="file:./data/db/biovolailles.db"

# Auth token for a remote libSQL/Turso database (`turso db tokens create <name>`).
# Leave unset for a local file database or the demo snapshot.
# DATABASE_AUTH_TOKEN=""

# Encryption key for iron-session cookies. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value in production than locally, and never commit either.
#
# On Vercel in demo-snapshot mode (no DATABASE_URL) this is OPTIONAL: a key is derived from the
# deployment's own identity, so the demo deploys with no variables at all. Setting it anyway
# keeps sessions valid across redeploys. With a persistent database it is REQUIRED.
SESSION_SECRET="replace-with-a-random-32-character-minimum-secret"

# Public origin the QR passport links point at (no trailing slash). Server-side only.
# On Vercel this is derived automatically from the deployment URL, so leave it unset there
# unless the app is served from a custom domain — then set it to that domain.
APP_URL="http://localhost:3000"

# Enables the presenter tooling on /administration/demo: the destructive demo reset and the
# "replay the anomaly" controls. Defaults to ON outside production and OFF in production.
#
# IMPORTANT for a jury/demo machine: `npm run start` runs with NODE_ENV=production, so the
# controls are OFF unless you set this explicitly. Uncomment the line below on a demo laptop.
# Leave it commented on any deployment holding data you care about — the reset wipes the
# database. On Vercel, leave it off: the reset replays the full seed, which is far slower
# over a network database than a serverless function is allowed to run.
# DEMO_MODE="true"

# ---------------------------------------------------------------------------
# BVU Tech extension (all optional)
# ---------------------------------------------------------------------------

# New-lead e-mail notification from the public contact form, through Resend's HTTP API.
# All three are needed; with any missing, leads are only stored and listed on /prospects.
# RESEND_API_KEY=""
# LEADS_NOTIFY_TO="commercial@example.ma"
# LEADS_NOTIFY_FROM="BVU Tech <site@your-verified-domain.ma>"

# HMAC key that signs ledger anchors (/journal). Falls back to SESSION_SECRET. Set a separate,
# long-lived value in production: rotating SESSION_SECRET would otherwise invalidate every
# anchor ever handed to an auditor.
# LEDGER_ANCHOR_KEY=""

# Telemetry (client documents 2 and 3).
#
# Sender of alert e-mails, through Resend (RESEND_API_KEY above). Unset: alert notifications are
# recorded as "not configured" on each alert — never silently dropped. No SMS or voice provider
# is integrated; the autonomous GSM alarm (L01) stays the emergency path.
# ALERTS_NOTIFY_FROM=alertes@your-domain.ma
#
# Shared secret for GET /api/cron/telemetry (Authorization: Bearer <secret>), to run every
# 5 minutes: rules left behind by a backlog, silence check, escalation, retention tiers.
# Unset: the route stays closed. Self-hosted: `npm run telemetry:jobs` from cron instead.
# CRON_SECRET=at-least-16-random-characters
